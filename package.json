    "eslint-plugin-security": "^1.7.1",
    "html-webpack-plugin": "^5.0.0",
    "husky": "^4.3.7",
    "jest": "^26.6.3",
    "lint-staged": "^10.5.3",
    "nodemon": "^2.0.19",
    "npm-run-all": "^4.1.5",
    "postcss-loader": "^4.1.0",
    "postcss-preset-env": "^6.7.0",
    "prettier": "^2.8.1",
