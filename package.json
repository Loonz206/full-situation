{
  "name": "full-situation",
  "version": "1.0.0",
  "description": "React App with WP5 and GraphQL",
  "private": true,
  "scripts": {
    "build": "webpack",
    "check-format": "npm run pretty -- --list-different",
    "clean": "rm -rf ./dist",
    "commit": "npx git-cz",
    "coverage": "jest --config jest.config.js",
    "dev": "webpack serve",
    "format": "npm run pretty -- --write",
    "lint": "eslint --ignore-path .gitignore --ext .js --ext .jsx --ext .ts --ext .tsx .",
    "pretty": "prettier --ignore-path .gitignore \"**/*.+(js|jsx|ts|tsx|json|md)\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "validate": "npm-run-all --parallel check-format lint type-check",
    "server:start": "nodemon NODE_ENV=development ./server/server.js --ignore client"
  },
  "author": "@loonz206",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-transform-runtime": "^7.21.0",
    "@babel/preset-env": "^7.18.10",
    "@babel/preset-react": "^7.12.10",
    "@babel/preset-typescript": "^7.28.5",
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@testing-library/jest-dom": "^5.11.9",
    "@testing-library/react": "^11.2.3",
    "@types/bcrypt-nodejs": "^0.0.31",
    "@types/connect-mongo": "^3.1.2",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^25.5.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^17.0.91",
    "@types/react-dom": "^17.0.26",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^26.6.3",
    "babel-loader": "^8.2.2",
    "babel-preset-react": "^6.24.1",
    "clean-webpack-plugin": "^3.0.0",
    "css-loader": "^5.0.1",
    "eslint": "^7.17.0",
